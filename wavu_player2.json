      <div class="replays profile-filters-target">
         <div id="session-plot"></div>

         <script type="module">
            (function () {

               const data = [{"battle_at":1785471738,"n":1,"opp_name":"Dlew","rating_after":1146,"rating_before":1056,"sess_start":1785471232},{"battle_at":1785471232,"n":2,"opp_name":"BOJACK","rating_after":1055,"rating_before":1074,"sess_start":1785471232},{"battle_at":1765346602,"n":3,"opp_name":"Daffy.66","rating_after":1074,"rating_before":1085,"sess_start":1765346284},{"battle_at":1765346455,"n":4,"opp_name":"Daffy.66","rating_after":1085,"rating_before":1099,"sess_start":1765346284},{"battle_at":1765346284,"n":5,"opp_name":"Daffy.66","rating_after":1099,"rating_before":1119,"sess_start":1765346284},{"battle_at":1765013858,"n":6,"opp_name":"LIMN","rating_after":1119,"rating_before":1136,"sess_start":1765010246},{"battle_at":1765013726,"n":7,"opp_name":"LIMN","rating_after":1135,"rating_before":1161,"sess_start":1765010246},{"battle_at":1765010515,"n":8,"opp_name":"Felix","rating_after":1160,"rating_before":1212,"sess_start":1765010246},{"battle_at":1765010246,"n":9,"opp_name":"Felix","rating_after":1212,"rating_before":1312,"sess_start":1765010246},{"battle_at":1764043837,"n":10,"opp_name":"Riku","rating_after":1311,"rating_before":1346,"sess_start":1764043302},{"battle_at":1764043623,"n":11,"opp_name":"Riku","rating_after":1346,"rating_before":1407,"sess_start":1764043302},{"battle_at":1764043302,"n":12,"opp_name":"JusticeBrigade","rating_after":1407,"rating_before":1500,"sess_start":1764043302}];
               if (!data.length) return;

               let [min, max] = [Number.MAX_VALUE, 0];
               data.forEach(e => {
                  if (e.rating_after < min) min = e.rating_after;
                  if (e.rating_before < min) min = e.rating_before;
                  if (e.rating_after > max) max = e.rating_after;
                  if (e.rating_before > max) max = e.rating_before;
               });

               const height = 300;
               const yAxisWidth = 55;
               const margin = { top: 30, bottom: 15, left: yAxisWidth - 5, right: 10 };
               const target = document.querySelector("#session-plot");
               const minDomain = 200;
               const gutter = (max - min < minDomain) ? (minDomain - max + min) / 2 : 0;

               let draw = function () {
                  const containerWidth = target.getBoundingClientRect().width;

                  const yScale = Plot.scale({ y: { domain: [ min - gutter, max + gutter ], nice: true } });

                  const yAxis = Plot.plot({
                     width: yAxisWidth,
                     height: height,
                     marginTop: margin.top,
                     marginBottom: margin.bottom,
                     marginLeft: margin.left,
                     y: yScale,
                     style: { fontSize: "14px", maxWidth: "initial", flexShrink: 0, alignSelf: "start" },
                     marks: [
                        Plot.axisY({ label: "Rating", tickFormat: (d) => d.toLocaleString(undefined, { useGrouping: "min2" }) }),
                     ],
                  });

                  const chart = Plot.plot({
                     height: height,
                     width: Math.max(50 + data.length * 13, Math.min(containerWidth - yAxisWidth, 50 + data.length * 35)),
                     marginTop: margin.top,
                     marginRight: margin.right,
                     marginBottom: margin.bottom,
                     marginLeft: 0,
                     x: { axis: null, reverse: true },
                     y: yScale,
                     color: {
                        scheme: "observable10",
                        type: "categorical",
                     },
                     style: { maxWidth: "initial" },
                     marks: [
                        Plot.gridY({ stroke: "lch( from var(--bg) calc(l * 0.4 + 20) c h)", strokeOpacity: 1 }),
                        Plot.link(data, {
                           x1: "n",
                           x2: (d) => d.n - 1,
                           y1: "rating_before",
                           y2: "rating_after",
                              stroke: "opp_name",
                           strokeWidth: 3,
                           markerEnd: "circle-stroke",
                        }),
                        Plot.axisY({ ticks: [] }),
                     ]
                  });

                  let legend = chart.legend('color');
                  legend.style.fontSize = "0.8em";

                  let flex = document.createElement('div');
                  flex.style.display = "flex";

                  let wrapper =  document.createElement('div');
                  wrapper.style.overflowX = "auto";

                  wrapper.append(chart);
                  flex.append(yAxis);
                  flex.append(wrapper);

                  target.replaceChildren(legend);
                  target.append(flex);
               };

               draw();
               window.addEventListener('resize', debounce(draw, 100));
            })();
         </script>

         


