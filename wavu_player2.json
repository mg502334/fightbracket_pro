<script class="hidden">
(function () {
   var nameHistory = document.querySelector('.name-history');
   var playerHeader = document.querySelector('.player-header');
   var playerRatings = document.querySelector('.player-ratings');
   var carousel = document.querySelector('.player-ratings .carousel');
   var button = document.querySelector('.name-history button');
   var showMore = false;
   var collapsible = {};

   if (button) {
      button.addEventListener('click', function () {
         showMore = !showMore;
         nameHistory.classList[showMore ? 'remove' : 'add']('collapsed');
      });
   }

   var prevWidth = 0;
   var sizeCheck = function () {
      // CSS isn't loaded yet, so following checks are invalid
      if (window.getComputedStyle(playerRatings).getPropertyValue("grid-area") === "") return;

      if (window.innerWidth === prevWidth) return;
      prevWidth = window.innerWidth;

      // If ratings are short enough, no need for scrolling
      playerRatings.classList.remove('short');
      if (carousel.scrollWidth == carousel.clientWidth) {
         playerRatings.classList.add('short');
      }

      // If name history is small enough, no need for collapsible behaviour
      if (!nameHistory) return;

      // Only need to test once for each breakpoint
      var bp = window.getComputedStyle(nameHistory).getPropertyValue('min-height') == "100%" ? "big" : "small";
      if (collapsible[bp] === undefined) {
         nameHistory.classList.add('collapsed');
         button.classList.remove('hidden');
         var containerHeight = nameHistory.querySelector('.table').getBoundingClientRect().height;
         var tableHeight = nameHistory.querySelector('.table table').getBoundingClientRect().height;
         var buttonHeight = button.getBoundingClientRect().height;
         collapsible[bp] = tableHeight >= containerHeight + buttonHeight;
      }

      if (collapsible[bp]) {
         nameHistory.classList[ showMore ? 'remove' : 'add' ]('collapsed');
         button.classList.remove('hidden');
      } else {
         nameHistory.classList.remove('collapsed');
         button.classList.add('hidden');
      }
   };

   sizeCheck();
   document.addEventListener('DOMContentLoaded', sizeCheck);
   window.addEventListener('resize', sizeCheck);
})()
</script>


