      <script>
         function parseHTML(html) {
             var t = document.createElement('template');
             t.innerHTML = html;
             return t.content;
         }

         function debounce(f, t) {
            let tid;
            return function() {
               clearTimeout(tid);
               tid = setTimeout(f, t);
            }
         }

         function printDate(t) {
            document.currentScript.insertAdjacentHTML('beforebegin', (new Date(t*1000)).toLocaleString(undefined, {
               day: "numeric",
               month: "short",
               year: "2-digit",
            }));
         }

         function printDateTime(t) {
            document.currentScript.insertAdjacentHTML('beforebegin', (new Date(t*1000)).toLocaleString(undefined, {
               day: "numeric",
               month: "short",
               year: "2-digit",
               hour: "2-digit",
               minute: "2-digit",
               hourCycle: "h23",
            }));
         }
      </script>
