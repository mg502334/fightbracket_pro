# Discord Bot Credentials
# Get your token at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# (Optional) Specific Server / Guild ID to instantly register slash commands without waiting for global propagation
DISCORD_GUILD_ID=

# Default Channel Targets (Name or numeric Channel ID)
DEFAULT_VOICE_CHANNEL="Tekken 8 Voice"
DEFAULT_TEXT_CHANNEL="tekken-matches"

# Webhook Bridge for FightBracket Pro
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5050

# Voice Announcer Configuration
# Recommended Edge-TTS voices: en-US-ChristopherNeural, en-US-GuyNeural, en-US-EricNeural, en-GB-RyanNeural
ANNOUNCER_VOICE=en-US-ChristopherNeural
TTS_VOLUME=1.0
ENABLE_VOICE_TTS=true
AUTO_JOIN_VOICE=true

# Tournament Branding
TOURNAMENT_NAME="Tekken 8 Championship"
